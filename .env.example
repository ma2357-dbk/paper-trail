# Copy to .env and fill in. Never commit .env.
DATABASE_URL="file:./prisma/dev.db"

# External REST APIs (no key needed for Nager.Date / REST Countries; add keys here if the team picks a keyed API)
# EXAMPLE_API_KEY=

# Nager.Date base URL. Leave unset for the real service; point it at a dead
# address (e.g. http://127.0.0.1:9/api/v3) to see the "holidays unavailable" fallback.
# NAGER_DATE_BASE_URL=
